# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2025b
startdir = /home/thanotos/BalanceCube/codegen

# Toolchain information
cc = /usr/bin/gcc
cxx = /usr/bin/g++
linker = /usr/bin/gcc
linkerxx = /usr/bin/g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c99 -I "$startdir" -I "../interface" -I ".." -I "$matlabdir/toolbox/coder/rtiostream/src/utils_host" -I "$matlabdir/extern/include" -I "." -DMODEL=balanceCubeControllerStep_sil -DMATLAB_MEX_FILE -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -fno-predictive-commoning -std=c++11 -I "$startdir" -I "../interface" -I ".." -I "$matlabdir/toolbox/coder/rtiostream/src/utils_host" -I "$matlabdir/extern/include" -I "." -DMODEL=balanceCubeControllerStep_sil -DMATLAB_MEX_FILE -Wno-stringop-overflow -Wno-maybe-uninitialized -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o balanceCubeControllerStep_sil.mexa64 -lfixedpoint -lmwcoder_CoderAssumpHostAppSvc -lmwcoder_XILHostAppSvc -lmwrtiostreamutils -lmwxilcomms_rtiostream -lmwxilutils -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,balanceCubeControllerStep.map

ldxxflags =  -pthread -Wl,--no-undefined  -shared -lstdc++ -Wl,--as-needed -Wl,-rpath-link,$matlabdir/bin/glnxa64 -L"$matlabdir/bin/glnxa64" -Wl,-rpath-link,$matlabdir/extern/bin/glnxa64 -L"$matlabdir/extern/bin/glnxa64" -lMatlabDataArray -lmx -lmex -lm -lmat  -Wl,-Bsymbolic -o balanceCubeControllerStep_sil.mexa64 -lfixedpoint -lmwcoder_CoderAssumpHostAppSvc -lmwcoder_XILHostAppSvc -lmwrtiostreamutils -lmwxilcomms_rtiostream -lmwxilutils -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,balanceCubeControllerStep.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldxxflags

# Build
build $builddir/balanceCubeControllerStep_sil.o : cc $root/balanceCubeControllerStep_sil.c
build $builddir/_coder_balanceCubeControllerStep_info.o : cc ../interface/_coder_balanceCubeControllerStep_info.c
build $builddir/_coder_balanceCubeControllerStep_api.o : cc ../interface/_coder_balanceCubeControllerStep_api.c
build $builddir/_coder_balanceCubeControllerStep_mex.o : cc ../interface/_coder_balanceCubeControllerStep_mex.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/balanceCubeControllerStep_sil.mexa64 : link $builddir/balanceCubeControllerStep_sil.o $builddir/_coder_balanceCubeControllerStep_info.o $builddir/_coder_balanceCubeControllerStep_api.o $builddir/_coder_balanceCubeControllerStep_mex.o $builddir/c_mexapi_version.o 
